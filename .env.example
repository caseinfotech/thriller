ORGANIZER_EMAIL=your-organizer-email@example.com
# Vercel server-only credential for the existing private Sites backend.
SITES_SERVICE_TOKEN=
# Shared organizer-link key, configured as a secret on Sites and Vercel production.
ORGANIZER_ACCESS_KEY=

# Sites server-only notice mailer settings. SHA-256 digest of a six-digit PIN.
MAILER_PIN_HASH=
# Resend API key and a verified sender, e.g. South Haven Thriller <notices@example.com>.
RESEND_API_KEY=
NOTICE_FROM_EMAIL=noreply@nextdesign.dev
